# Point the web app at a Hearth API. Copy this to web/.env.local, which is
# git-ignored. Restart the dev server after changing it: Next inlines
# NEXT_PUBLIC_ variables at build time, so a reload alone will not pick it up.
#
# With this set you get the real sweep, the Vexcel aerial tile and the Matterport
# scan instead of the drawn fixtures. You will still be asked for the shared
# password on first load; it is kept in this browser only.
#
# This is the API the deployed site already uses.
NEXT_PUBLIC_API=https://hearth-api-six.vercel.app

# Or a Hearth API running on this machine, which is the one that can reach a
# local CoStar kit:
#   uv run uvicorn api.main:app --port 8000
# NEXT_PUBLIC_API=http://localhost:8000

# No value at all is also valid: every page falls back to web/public/dev/api/**
# and says "Fixture" on its badge.
