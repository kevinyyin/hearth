{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "codex/*": false
    }
  },
  "functions": {
    "api/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env,.env.*,.claude/**,.superpowers/**,.venv/**,web/**,tests/**,docs/**,evals/**,scripts/**,results/beryl_*/**,data/raw/**,data/processed/**,data/remote/**,data/*.db,data/buildings/!(_fixtures)/**}"
    }
  }
}
